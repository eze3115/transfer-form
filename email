import sgMail from '@sendgrid/mail';

const logOnly = !process.env.SENDGRID_API_KEY;
if (!logOnly) sgMail.setApiKey(process.env.SENDGRID_API_KEY);

export async function sendEmail({ to, subject, html }) {
  if (logOnly) {
    console.log('\n--- EMAIL (dev log) ---');
    console.log('To:', to);
    console.log('Subject:', subject);
    console.log('HTML:', html);
    console.log('------------------------\n');
    return;
  }
  const from = {
    email: process.env.FROM_EMAIL || 'no-reply@example.com',
    name: process.env.FROM_NAME || 'Transfer Forms'
  };
  await sgMail.send({ to, from, subject, html });
}
